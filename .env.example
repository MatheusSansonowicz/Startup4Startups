# ID do projeto no Firebase (Project Settings > General > Project ID)
FIREBASE_PROJECT_ID=seu-projeto-firebase

# Token de acesso OAuth2 de curta duração.
# Pra testar rápido, gere um com o gcloud CLI autenticado na conta de serviço:
#   gcloud auth print-access-token
# Em produção isso NÃO deveria ser um valor fixo no .env — veja o
# comentário em src/config.rs sobre trocar isso por um fluxo real
# de service account (ex: crate `gcp_auth`).
FIREBASE_ACCESS_TOKEN=coloque-o-token-aqui

# --- Relatório de mercado (diferencial via IA) ---

# Chave da SerpAPI (https://serpapi.com) — usada pra coletar dados de
# mercado/concorrentes sobre cada startup.
SERPAPI_KEY=coloque-sua-chave-serpapi-aqui

# Chave da API da Anthropic (https://console.anthropic.com) — usada pra
# sintetizar o relatório a partir dos dados coletados.
AI_API_KEY=coloque-sua-chave-de-ia-aqui

# Horas até um relatório em cache ser considerado "vencido" e regenerado.
# Padrão: 6 (se omitido no .env)
REPORT_CACHE_TTL_HOURS=6
